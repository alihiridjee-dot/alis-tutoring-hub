# Ali's Tutoring Hub — environment
#
# This project has its OWN Supabase project, completely separate from Anglia
# Educate. Do not paste Anglian's keys here: the two apps must never share a
# database or an auth user table.

# ── Supabase ────────────────────────────────────────────────────────────────
# URL and publishable key are safe to expose (they ship in the client bundle).
# Create the project at supabase.com, then: Project Settings → API.
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# SECRET — never commit a real value, never prefix with VITE_.
# Only used by scripts and server functions that create student accounts.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ──────────────────────────────────────────────────────────────────
# SECRET, server/script only. Independent students subscribe; agency-sourced
# students (Dulwich / Ivy / Bonas) are exempt and never hit checkout.
# Use sk_test_… until you're taking real money.
STRIPE_SECRET_KEY=

# ── Client-side (Vite build-time; VITE_ prefix IS exposed to the browser) ────
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
